<script>

/*
===========================================================
JAIN SIR'S K12 ACADEMY
STUDENT DASHBOARD - LIVE VERSION
===========================================================

Existing Apps Script endpoints used:

?action=login&rollNo=...&password=...
?action=syllabus&rollNo=...
?action=tests&rollNo=...
?action=testResults&rollNo=...

===========================================================
*/


// =========================================================
// GOOGLE APPS SCRIPT WEB APP URL
// =========================================================

const API_URL =
  "https://script.google.com/macros/s/AKfycbx3WcFm4HvfXqkjSqVbCq-YtfBnY4qoP7jIbTxukfh4cBdq9k_S3xCw-7PYaRN73-vapA/exec";


// =========================================================
// SCHOOL MARKS GOOGLE FORM
// =========================================================

const SCHOOL_MARKS_FORM_URL =
  "https://forms.gle/YOUR-SCHOOL-MARKS-FORM";


// =========================================================
// STUDENT SESSION
// =========================================================

let studentRollNo = "";

let studentData = {};


// =========================================================
// INITIALIZE
// =========================================================

document.addEventListener("DOMContentLoaded", function () {

  /*
   * We expect the student's login information to already
   * be stored by your existing login page.
   *
   * We first try localStorage.
   */

  studentRollNo =
    localStorage.getItem("studentRollNo") || "";

  const storedStudent =
    localStorage.getItem("studentData");

  if (storedStudent) {

    try {

      studentData =
        JSON.parse(storedStudent);

    } catch (err) {

      studentData = {};

    }

  }


  /*
   * If no Roll No is available, show a clear message.
   */

  if (!studentRollNo) {

    showDashboardMessage(
      "Student login information not found. Please login again."
    );

    return;

  }


  /*
   * Display whatever student information is already
   * available while live data loads.
   */

  if (studentData.name) {

    setStudentName(
      studentData.name
    );

  }

  if (studentData.className) {

    setStudentClass(
      studentData.className
    );

  }


  /*
   * Load live dashboard data.
   */

  loadStudentInformation();

});


// =========================================================
// LOAD ALL STUDENT INFORMATION
// =========================================================

async function loadStudentInformation() {

  try {

    await loadStudentLogin();

    await Promise.all([

      loadUpcomingTests(),

      loadSyllabus(),

      loadTestResults(),

      loadAttendance()

    ]);

  }

  catch (error) {

    console.error(
      "Dashboard loading error:",
      error
    );

  }

}


// =========================================================
// GENERIC API FUNCTION
// =========================================================

async function apiRequest(action) {

  const url =
    API_URL +
    "?action=" +
    encodeURIComponent(action) +
    "&rollNo=" +
    encodeURIComponent(studentRollNo);


  const response =
    await fetch(url);


  if (!response.ok) {

    throw new Error(
      "API request failed: " +
      response.status
    );

  }


  const data =
    await response.json();


  if (!data.success) {

    throw new Error(
      data.message ||
      "Unable to load data."
    );

  }


  return data;

}


// =========================================================
// LOAD STUDENT LOGIN / BASIC INFORMATION
// =========================================================

async function loadStudentLogin() {

  /*
   * Login endpoint requires password.
   *
   * The dashboard normally does not need to call login
   * again if the login page has already stored studentData.
   *
   * Therefore, if studentData already exists, use it.
   */

  if (
    studentData &&
    studentData.name
  ) {

    setStudentName(
      studentData.name
    );

  }

  if (
    studentData &&
    studentData.className
  ) {

    setStudentClass(
      studentData.className
    );

  }

}


// =========================================================
// SET STUDENT NAME
// =========================================================

function setStudentName(name) {

  const header =
    document.getElementById(
      "studentNameHeader"
    );

  const welcome =
    document.getElementById(
      "studentNameWelcome"
    );


  if (header) {

    header.textContent =
      name || "Student";

  }


  if (welcome) {

    welcome.textContent =
      name || "Student";

  }

}


// =========================================================
// SET STUDENT CLASS
// =========================================================

function setStudentClass(className) {

  const element =
    document.getElementById(
      "studentClassHeader"
    );


  if (element) {

    element.textContent =
      className || "";

  }

}


// =========================================================
// UPCOMING TESTS
// =========================================================

async function loadUpcomingTests() {

  const list =
    document.getElementById(
      "upcomingTestsList"
    );


  try {

    const data =
      await apiRequest("tests");


    const tests =
      data.tests || [];


    document.getElementById(
      "upcomingTestCount"
    ).textContent =
      tests.length;


    document.getElementById(
      "testBadge"
    ).textContent =
      tests.length +
      (
        tests.length === 1
          ? " upcoming"
          : " upcoming"
      );


    if (!tests.length) {

      list.innerHTML =
        '<p class="text-sm text-slate-500">' +
        'No upcoming tests.' +
        '</p>';

      return;

    }


    list.innerHTML =
      tests.map(function (test) {

        return `

          <div class="border rounded-2xl p-4">

            <div class="flex justify-between gap-3">

              <div>

                <p class="font-semibold">
                  ${escapeHtml(test.subject || "")}
                </p>

                <p class="text-sm text-slate-500">
                  ${escapeHtml(test.chapter || "")}
                </p>

              </div>

              <span
                class="text-xs bg-blue-50 text-blue-700 px-2 py-1 rounded-lg h-fit">

                ${escapeHtml(test.testName || "")}

              </span>

            </div>

            <p class="text-sm font-medium mt-3">

              📅 ${escapeHtml(test.date || "")}

            </p>

          </div>

        `;

      }).join("");


  }

  catch (error) {

    console.error(
      "Upcoming tests error:",
      error
    );


    list.innerHTML =
      '<p class="text-sm text-red-500">' +
      'Unable to load upcoming tests.' +
      '</p>';

  }

}


// =========================================================
// SYLLABUS
// =========================================================

async function loadSyllabus() {

  const list =
    document.getElementById(
      "syllabusList"
    );


  try {

    const data =
      await apiRequest("syllabus");


    /*
     * Your Apps Script returns:
     *
     * data.overall
     * data.subjects
     * data.chapters
     */


    const overall =
      data.overall &&
      typeof data.overall.percentage !== "undefined"
        ? Number(data.overall.percentage)
        : 0;


    document.getElementById(
      "syllabusPercent"
    ).textContent =
      overall + "%";


    document.getElementById(
      "syllabusBadge"
    ).textContent =
      overall + "%";


    const subjects =
      data.subjects || {};


    const subjectNames =
      Object.keys(subjects);


    if (!subjectNames.length) {

      list.innerHTML =
        '<p class="text-sm text-slate-500">' +
        'No syllabus data available.' +
        '</p>';

      return;

    }


    list.innerHTML =
      subjectNames.map(function (subject) {

        const item =
          subjects[subject];


        const percentage =
          Number(item.percentage || 0);


        return `

          <div>

            <div class="flex justify-between text-sm mb-1">

              <span class="font-medium">
                ${escapeHtml(subject)}
              </span>

              <span>
                ${percentage}%
              </span>

            </div>


            <div
              class="h-2 bg-slate-100 rounded-full overflow-hidden">

              <div
                class="progress-bar h-full bg-blue-600 rounded-full"
                style="width:${percentage}%">
              </div>

            </div>

          </div>

        `;

      }).join("");


  }

  catch (error) {

    console.error(
      "Syllabus error:",
      error
    );


    list.innerHTML =
      '<p class="text-sm text-red-500">' +
      'Unable to load syllabus.' +
      '</p>';

  }

}


// =========================================================
// K12 TEST RESULTS
// =========================================================

async function loadTestResults() {

  const list =
    document.getElementById(
      "performanceList"
    );


  try {

    const data =
      await apiRequest("testResults");


    const results =
      data.results || [];


    /*
     * No results yet
     */

    if (!results.length) {

      document.getElementById(
        "performanceAverage"
      ).textContent =
        "--";


      list.innerHTML =
        '<p class="text-sm text-slate-500">' +
        'No test results available yet.' +
        '</p>';

      return;

    }


    /*
     * Calculate average percentage
     */

    let totalPercentage = 0;

    let validResults = 0;


    results.forEach(function (result) {

      const marks =
        Number(result.marks);

      const total =
        Number(result.totalMarks);


      if (
        !isNaN(marks) &&
        !isNaN(total) &&
        total > 0
      ) {

        totalPercentage +=
          (marks / total) * 100;

        validResults++;

      }

    });


    const average =
      validResults > 0
        ? Math.round(
            totalPercentage /
            validResults
          )
        : 0;


    document.getElementById(
      "performanceAverage"
    ).textContent =
      average + "%";


    /*
     * Display most recent results first.
     */

    const recentResults =
      results.slice(-5).reverse();


    list.innerHTML =
      recentResults.map(function (result) {

        const marks =
          Number(result.marks);

        const total =
          Number(result.totalMarks);


        let percentage = 0;


        if (
          !isNaN(marks) &&
          !isNaN(total) &&
          total > 0
        ) {

          percentage =
            Math.round(
              (marks / total) * 100
            );

        }


        return `

          <div
            class="flex items-center justify-between border rounded-xl p-3">

            <div>

              <p class="font-medium text-sm">

                ${escapeHtml(
                  result.subject || ""
                )}

                ${result.testName
                  ? " - " +
                    escapeHtml(result.testName)
                  : ""
                }

              </p>


              <p class="text-xs text-slate-500">

                ${escapeHtml(
                  result.chapter || ""
                )}

                ${
                  result.date
                    ? " • " +
                      escapeHtml(result.date)
                    : ""
                }

              </p>


              <p class="text-xs text-slate-500 mt-1">

                ${escapeHtml(
                  result.marks || ""
                )}
                /
                ${escapeHtml(
                  result.totalMarks || ""
                )}

              </p>

            </div>


            <span class="font-bold">

              ${percentage}%

            </span>

          </div>

        `;

      }).join("");


  }

  catch (error) {

    console.error(
      "Test results error:",
      error
    );


    document.getElementById(
      "performanceAverage"
    ).textContent =
      "--";


    list.innerHTML =
      '<p class="text-sm text-red-500">' +
      'Unable to load test results.' +
      '</p>';

  }

}


// =========================================================
// ATTENDANCE
// =========================================================

async function loadAttendance() {

  /*
   * Attendance endpoint has not yet been created
   * in the Apps Script code shown so far.
   *
   * Therefore we do NOT invent attendance data.
   *
   * Keep the dashboard showing "--" until the endpoint
   * is added.
   */


  document.getElementById(
    "attendancePercent"
  ).textContent =
    "--";


  document.getElementById(
    "attendanceText"
  ).textContent =
    "--";


  document.getElementById(
    "presentCount"
  ).textContent =
    "--";


  document.getElementById(
    "absentCount"
  ).textContent =
    "--";


  document.getElementById(
    "attendanceBar"
  ).style.width =
    "0%";

}


// =========================================================
// SCHOOL MARKS FORM
// =========================================================

function openSchoolMarksForm() {

  if (
    !SCHOOL_MARKS_FORM_URL ||
    SCHOOL_MARKS_FORM_URL.includes(
      "YOUR-SCHOOL"
    )
  ) {

    alert(
      "School Test Marks Google Form link has not been added yet."
    );

    return;

  }


  window.open(
    SCHOOL_MARKS_FORM_URL,
    "_blank"
  );

}


